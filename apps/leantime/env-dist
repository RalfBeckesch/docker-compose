# =============================================================================
# Leantime – Environment Distribution File
# Copy this file to ".env" and fill in your values before starting the stack.
#
#   cp env-dist .env
#   chmod 600 .env
#
# Every value marked CHANGEME must be replaced before the first start –
# scripts/bootstrap.sh does that for you and generates the secrets.
#
# This file is read twice: by Docker Compose (interpolation) and as env_file by
# both services. Keep it shell-compatible: no spaces around "=", no unescaped $.
#
# The complete list of application variables is config/sample.env in the
# Leantime repository at the pinned tag. Optional blocks below are commented out
# on purpose – an active line overrides the application's own default, so only
# enable what you actually need.
# =============================================================================

# -----------------------------------------------------------------------------
# Compose / Project
# -----------------------------------------------------------------------------

# Prefix for all container names of this stack.
COMPOSE_PROJECT_NAME=leantime

# -----------------------------------------------------------------------------
# Docker Images
# -----------------------------------------------------------------------------

# Leantime image tag. Pin a released version, never "latest": an unpinned tag
# pulls an arbitrary version on the next `docker compose pull`.
# Tags: https://hub.docker.com/r/leantime/leantime/tags
# Note: the Docker tag carries no "v" prefix (3.13.2), the Git tag does (v3.13.2).
LEANTIME_VERSION=3.13.2

# MariaDB image tag. Leantime's requirements list "MySQL 8.0+ or MariaDB 10.6+",
# and the maintainers run their own cloud instances on MariaDB (see
# https://github.com/Leantime/leantime/discussions/1782). The upstream Helm
# chart also deploys MariaDB. 11.4 is a long-term-support release.
# Tags: https://hub.docker.com/r/library/mariadb/tags
MARIADB_VERSION=11.4

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# Address the Leantime web UI is published on.
#   127.0.0.1 → loopback only, intended to sit behind a reverse proxy (default)
#   0.0.0.0   → reachable from the LAN
# Restrict access with a firewall/VLAN if you bind to 0.0.0.0.
LEAN_BIND_ADDR=127.0.0.1

# Host port mapped to the container's port 8080.
LEAN_HOST_PORT=8080

# Port Leantime itself uses inside the container. This is fixed by the image's
# nginx configuration and must stay 8080 – the host port above is the one you
# change. Only change this if you build your own image.
LEAN_PORT=8080

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# Host path for the MariaDB data directory. The container's entrypoint starts as
# root and fixes the ownership itself – do not chown it from the host.
# The directory format is MariaDB-specific: it cannot be swapped with a MySQL
# data directory. A migration between the two engines goes through dump/restore.
MARIADB_DATA=./data/leantime/mariadb

# Host paths for the four writable application directories. They must belong to
# LEAN_UID:LEAN_GID (scripts/bootstrap.sh sets that up).
#   userfiles         → uploaded files and project attachments
#   public-userfiles  → logos and other publicly served files
#   plugins           → installed plugins
#   logs              → LEAN_LOG_CHANNELS=single writes storage/logs/leantime.log
LEAN_USERFILES=./data/leantime/userfiles
LEAN_PUBLIC_USERFILES=./data/leantime/public-userfiles
LEAN_PLUGINS=./data/leantime/plugins
LEAN_LOGS=./data/leantime/logs

# -----------------------------------------------------------------------------
# Leantime Application – Core
# -----------------------------------------------------------------------------

# Public base URL including the scheme and a trailing slash. Not optional:
# without it password-reset and invitation mails are not sent. Set this to the
# external URL once the reverse proxy terminates TLS.
LEAN_APP_URL=http://localhost:8080/

# Subfolder the app is served from, without a trailing slash (e.g. /leantime).
# Leave empty for a domain-root installation. Also used for the cookie path.
LEAN_APP_DIR=

# User/group the application runs as inside the container. The published image
# is built for uid 1000 and group 0 (www-data:0 with group-writable dirs).
# PUID/PGID are BUILD args – setting them here has no effect on the image.
LEAN_UID=1000
LEAN_GID=0

# Name shown in the UI and in notification mails.
LEAN_SITENAME=Leantime

# Default language for new users.
LEAN_LANGUAGE=en-US

# Default timezone for new users (and for date handling).
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LEAN_DEFAULT_TIMEZONE=America/Winnipeg

# Debug flag. Leave 0 in production: 1 exposes stack traces and query output.
LEAN_DEBUG=0

# Session salting key. Generate one:
#   openssl rand -hex 32
# Changing this value later logs every user out.
LEAN_SESSION_PASSWORD=CHANGEME

# Session idle timeout in MINUTES (Laravel's session.lifetime unit).
# 480 minutes = 8 hours. The Docker-Repo sample.env still claims seconds and
# suggests 28800 – that would be a 60× longer timeout.
LEAN_SESSION_EXPIRATION=480

# Serve cookies over HTTPS only. Set to true once the reverse proxy terminates
# TLS; false while the stack is reached over plain HTTP.
LEAN_SESSION_SECURE=false

# Send a daily anonymous usage summary to telemetry.leantime.io. false = never.
LEAN_ALLOW_TELEMETRY=false

# Leantime's news widget. false for instances without outbound access.
LEAN_NEWS_ENABLED=false

# Logging channels (comma-separated): single, syslog, sentry, stderr.
# "single" writes storage/logs/leantime.log (mounted above); "stderr" sends to
# the container log. The image default "single,syslog,sentry" also tries syslog,
# which has no daemon in the container.
LEAN_LOG_CHANNELS=single

# Write PHP deprecation notices to logs/deprecations.log. 0 = off.
LEAN_LOG_DEPRECATIONS=0

# Full path of the application error log. Empty = storage/logs/error.log, which
# sits inside the LEAN_LOGS bind mount.
#LEAN_LOG_PATH=

# Refresh page content in place after closing a modal that changed data.
# false = full page reload.
LEAN_SOFT_RELOAD=true

# Hide the username/password form. Only useful when another login method
# (LDAP, OIDC) is active; otherwise nobody can log in.
LEAN_DISABLE_LOGIN_FORM=false

# Enforce #[RequiresPermission] denials (403 / RPC -32001). false = audit mode:
# denials are only logged. Leave true unless you are rolling out permissions.
LEAN_PERMISSIONS_ENFORCE=true

# -----------------------------------------------------------------------------
# Reverse Proxy / Security
# -----------------------------------------------------------------------------

# Send an HSTS header. Leave false on plain HTTP; enable together with TLS.
#LEAN_HSTS_ENABLED=false

# Reverse proxies whose X-Forwarded-For/-Proto/-Host headers are trusted
# (comma-separated IPs or CIDR ranges). Unset = loopback + private networks,
# which covers Docker and LAN proxies. A proxy/CDN on a PUBLIC address
# (Cloudflare, etc.) must be listed here, otherwise client IPs and HTTPS
# detection come from the proxy itself. 'REMOTE_ADDR' trusts every client and
# allows IP spoofing – only for instances unreachable without the proxy.
#LEAN_TRUSTED_PROXIES=10.0.0.5,172.16.0.0/12

# Reject POST/PUT/PATCH/DELETE from other sites (Sec-Fetch-Site/Origin/Referer
# checked against the request host and LEAN_APP_URL). API-key/Bearer requests
# are exempt. Only disable as an emergency switch.
LEAN_CSRF_ORIGIN_CHECK=true

# -----------------------------------------------------------------------------
# Look & Feel (defaults; users can override in the UI)
# -----------------------------------------------------------------------------

LEAN_LOGO_PATH=/dist/images/logo.svg
LEAN_PRINT_LOGO_URL=/dist/images/logo.png
LEAN_DEFAULT_THEME=default
LEAN_PRIMARY_COLOR=#006d9f
LEAN_SECONDARY_COLOR=#00a886

# Unsplash access key (unsplash.com/developers) – lets users pick Unsplash
# photos as a background. Leave empty to disable.
#LEAN_UNSPLASH_ACCESS_KEY=

# -----------------------------------------------------------------------------
# File Uploads
# -----------------------------------------------------------------------------

# Local relative path for uploaded files. Matches the userfiles bind mount;
# leave at the default unless you know the image layout.
LEAN_USER_FILE_PATH=userfiles/

# Local relative path for Leantime's OWN database backups. This path is INSIDE
# the container and is not mounted – the files disappear on recreate. Use
# scripts/backup.sh for real backups; this only feeds the in-app backup button.
LEAN_DB_BACKUP_PATH=backupdb/

# --- S3 / S3-compatible object storage (optional, replaces local uploads) ----
#LEAN_USE_S3=false
#LEAN_S3_KEY=
#LEAN_S3_SECRET=
#LEAN_S3_BUCKET=
#LEAN_S3_REGION=
#LEAN_S3_FOLDER_NAME=
#LEAN_S3_END_POINT=
# Path-style endpoint: false => https://[bucket].[endpoint]; true => https://[endpoint]/[bucket]
#LEAN_S3_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# Without a working mail path, password resets and invitations never arrive.
# The container ships no local MTA, so point Leantime at an SMTP server. With
# LEAN_EMAIL_USE_SMTP=false the PHP mail() function is used, which fails here.

# Envelope sender / return address. Must be a valid address on your mail server,
# otherwise SPF/DMARC rejects the mail.
LEAN_EMAIL_RETURN=

# Display name of the sender. Empty = "Leantime".
LEAN_EMAIL_FROM_NAME=

# false = PHP mail() (needs a local MTA – not available in this image)
# true  = SMTP, configured by the block below
LEAN_EMAIL_USE_SMTP=false

# SMTP server hostname or IP.
LEAN_EMAIL_SMTP_HOSTS=

# Port: 587 = STARTTLS/submission, 465 = implicit TLS, 25 = unencrypted/relay.
LEAN_EMAIL_SMTP_PORT=

# Security protocol: TLS, SSL or STARTTLS. Must match the port and the server.
LEAN_EMAIL_SMTP_SECURE=

# SMTP authentication. Most providers require it; leave false only for an
# internal relay that accepts unauthenticated clients.
LEAN_EMAIL_SMTP_AUTH=true

LEAN_EMAIL_SMTP_USERNAME=
LEAN_EMAIL_SMTP_PASSWORD=

# Upgrade to TLS automatically when the server offers it (STARTTLS).
LEAN_EMAIL_SMTP_AUTO_TLS=true

# Accept self-signed or otherwise unverifiable certificates. false = verify.
LEAN_EMAIL_SMTP_SSLNOVERIFY=false

# -----------------------------------------------------------------------------
# LDAP (optional)
# -----------------------------------------------------------------------------
# Values containing JSON must stay on ONE line: Docker's env_file parser is
# line-based and would cut a multi-line value at the first line break.

#LEAN_LDAP_USE_LDAP=false
# Domain suffix appended to bare usernames, e.g. example.com for user@example.com
#LEAN_LDAP_LDAP_DOMAIN=
# OL = OpenLDAP, AD = Active Directory
#LEAN_LDAP_LDAP_TYPE=OL
#LEAN_LDAP_HOST=
#LEAN_LDAP_PORT=389
# Alternative to host+port, e.g. ldap://ldap.example.com:389
#LEAN_LDAP_URI=
# Users location, e.g. CN=users,DC=example,DC=com
#LEAN_LDAP_DN=
# Attribute mapping, single-line JSON. OpenLDAP default:
#LEAN_LDAP_KEYS={"username":"uid","groups":"memberOf","email":"mail","firstname":"displayname","lastname":"","phone":"telephoneNumber","jobTitle":"title","jobLevel":"level","department":"department"}
# Active Directory variant:
#LEAN_LDAP_KEYS={"username":"sAMAccountName","groups":"memberOf","email":"mail","firstname":"givenName","lastname":"sn","phone":"telephoneNumber","jobTitle":"title","jobLevel":"level","department":"department"}
# Leantime role id assigned on creation (20 = editor)
#LEAN_LDAP_DEFAULT_ROLE_KEY=20
# Role assignment per LDAP group, single-line JSON
#LEAN_LDAP_GROUP_ASSIGNMENT={"5":{"ltRole":"readonly","ldapRole":"readonly"},"10":{"ltRole":"commenter","ldapRole":"commenter"},"20":{"ltRole":"editor","ldapRole":"editor"},"30":{"ltRole":"manager","ldapRole":"manager"},"40":{"ltRole":"admin","ldapRole":"administrators"},"50":{"ltRole":"owner","ldapRole":"administrators"}}

# -----------------------------------------------------------------------------
# OpenID Connect / SSO (optional)
# -----------------------------------------------------------------------------

#LEAN_OIDC_ENABLE=false
#LEAN_OIDC_CLIENT_ID=
#LEAN_OIDC_CLIENT_SECRET=
# Provider discovery URL (…/.well-known/openid-configuration)
#LEAN_OIDC_PROVIDER_URL=
# Create the user in Leantime on first login; false = login fails for unknown users
#LEAN_OIDC_CREATE_USER=false
# Leantime role id for OIDC-created users (20 = editor)
#LEAN_OIDC_DEFAULT_ROLE=20
# Reject logins where the provider reports email_verified=false. Providers that
# do not send the claim (Entra ID, GitHub) are unaffected.
#LEAN_OIDC_REQUIRE_VERIFIED_EMAIL=true
# Skip TLS verification of the provider. Only for self-signed providers on a
# trusted network.
#LEAN_OIDC_SKIP_TLS_VERIFY=false
# Overrides when the provider's discovery document is incomplete
#LEAN_OIDC_AUTH_URL_OVERRIDE=
#LEAN_OIDC_TOKEN_URL_OVERRIDE=
#LEAN_OIDC_JWKS_URL_OVERRIDE=
#LEAN_OIDC_USERINFO_URL_OVERRIDE=
# Public key for RSA validation, as string or as mounted file path
#LEAN_OIDC_CERTIFICATE_STRING=
#LEAN_OIDC_CERTIFICATE_FILE=
# Requested scopes, e.g. openid profile email
#LEAN_OIDC_SCOPES=
# Claim names carrying the user fields
#LEAN_OIDC_FIELD_EMAIL=
#LEAN_OIDC_FIELD_FIRSTNAME=
#LEAN_OIDC_FIELD_LASTNAME=
#LEAN_OIDC_FIELD_PHONE=
#LEAN_OIDC_FIELD_JOBTITLE=
#LEAN_OIDC_FIELD_JOBLEVEL=
#LEAN_OIDC_FIELD_DEPARTMENT=

# -----------------------------------------------------------------------------
# Mobile Push (optional)
# -----------------------------------------------------------------------------
# Direct Firebase sending is for Leantime Cloud. Self-hosted instances use the
# relay in Company Settings instead (needs an AdvancedAuth licence).

#LEAN_PUSH_FCM_CREDENTIALS_PATH=
#LEAN_PUSH_FCM_PROJECT_ID=
#LEAN_PUSH_RELAY_URL=https://accounts.leantime.io/pushRelay/send

# -----------------------------------------------------------------------------
# Redis (optional – sessions and cache)
# -----------------------------------------------------------------------------
# Leantime can use Redis for sessions and caching. Not part of this stack; only
# enable after adding a redis service to the Compose file.

LEAN_USE_REDIS=false
# Connection URL, e.g. tcp://1.2.3.4:6379 – append ?auth=<password> when needed
#LEAN_REDIS_URL=
#LEAN_REDIS_HOST=
#LEAN_REDIS_PORT=6379
#LEAN_REDIS_PASSWORD=
#LEAN_REDIS_SCHEME=
# Redis database for the cache (default 0)
#LEAN_REDIS_DB=0
# Separate database for SESSIONS so a cache FLUSHDB cannot log users out.
# Non-cluster setups only.
#LEAN_REDIS_SESSION_DB=1

# -----------------------------------------------------------------------------
# Rate Limiting (per minute, keyed by client IP + session user id)
# -----------------------------------------------------------------------------
# Defaults shown. Lower AUTH to harden brute-force protection; raise the invite
# limits for bulk onboarding or imports.

LEAN_RATELIMIT_GENERAL=2000
LEAN_RATELIMIT_API=120
LEAN_RATELIMIT_AUTH=20
LEAN_RATELIMIT_MCP=300
LEAN_RATELIMIT_SIGNUP=5
LEAN_RATELIMIT_PASSWORD_RESET=5
LEAN_RATELIMIT_TWOFA=5
LEAN_RATELIMIT_INVITES_USER=10
LEAN_RATELIMIT_INVITES_TENANT=30

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The service names stay MYSQL_* on purpose: the official mariadb image reads
# both the MYSQL_* and the MARIADB_* spellings. The Compose file maps them onto
# LEAN_DB_* for the application, so app and server always agree. Keeping the
# classic names means the same .env works if you ever switch back to mysql.

# Root password of the database server. Only the database container needs it.
MYSQL_ROOT_PASSWORD=CHANGEME

# Database and application user created on first start.
MYSQL_DATABASE=leantime
MYSQL_USER=leantime
MYSQL_PASSWORD=CHANGEME

# LEAN_DB_* is set by the Compose file from the four values above – do not set
# it here. Reference only:
#   LEAN_DB_HOST=db          LEAN_DB_PORT=3306
#   LEAN_DB_DATABASE         LEAN_DB_USER         LEAN_DB_PASSWORD

# --- Connection management (optional) ---------------------------------------
#LEAN_DB_PERSISTENT_CONNECTIONS=true
#LEAN_DB_MAX_CONNECTIONS=100
#LEAN_DB_MIN_CONNECTIONS=1
#LEAN_DB_CONNECTION_TIMEOUT=30
#LEAN_DB_IDLE_TIMEOUT=300

# --- Driver selection (optional) --------------------------------------------
# 'mysql' (default) or 'pgsql'. This stack ships a MariaDB service – keep mysql.
#LEAN_DB_DEFAULT_CONNECTION=mysql
# Only relevant for pgsql:
#LEAN_DB_SCHEMA=public
#LEAN_DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------

# Host path where scripts/backup.sh writes its timestamped backup sets
# (and where scripts/upgrade.sh keeps its pre-upgrade safety nets).
BACKUP_DIR=./backups

# How many days a backup set is kept before scripts/backup.sh prunes it.
# Override per run with: ./scripts/backup.sh --keep-days 30
BACKUP_KEEP_DAYS=7
